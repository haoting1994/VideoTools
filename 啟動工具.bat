@echo off
title Simple Editor
cd /d "%~dp0"
if not exist "%~dp0index.html" (
  echo.
  echo [ERROR] index.html not found.
  echo Please right-click the zip file and choose "Extract All" first.
  echo.
  pause
  exit /b 1
)
set "VT_ROOT=%~dp0"

rem ---- 1. Python (preferred) ----
for %%P in (python py python3) do (
  %%P -c "import http.server" >nul 2>&1 && (
    echo.
    echo   Started: http://localhost:8765/index.html
    echo   Keep this window open while editing.
    echo.
    start "" powershell -NoProfile -WindowStyle Hidden -Command "Start-Sleep -Seconds 2; Start-Process 'http://localhost:8765/index.html'"
    %%P -m http.server 8765 --bind 127.0.0.1
    goto :end
  )
)

rem ---- 2. PowerShell (built into Windows) ----
powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand 

:end
echo.
pause
